; Engine configuration file.
; Kage character: designed and rigged in Godot, exported to glTF for the Three.js game test.

config_version=5

[application]

config/name="Kage Character"
config/description="Kage, built in code: rig, skinned parts, painted textures and animations. Run build/build_kage.gd to rebuild and export kage.glb."
run/main_scene="res://preview.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

environment/defaults/default_clear_color=Color(0.07, 0.05, 0.05, 1)
anti_aliasing/quality/msaa_3d=2
