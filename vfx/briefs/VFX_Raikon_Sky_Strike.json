      "frame": 6,
      "name": "leader",
      "expect": "A dim red leader is half way down over a tightening red ground mark; nothing is white yet"
    },
    {
      "frame": 10,
      "name": "contact",
      "expect": "The full red bolt with a white core and three forks connects sky to ground with a white star at the foot"
    },
    {
      "frame": 14,
      "name": "dark frame",
      "expect": "The bolt is gone; only ground bloom, cracks and sparks remain lit"
    },
    {
      "frame": 16,
      "name": "return stroke",
      "expect": "A second bolt on a visibly different path, slightly thinner"
    },
    {
      "frame": 21,
      "name": "after-flicker",
      "expect": "A third, thin, pale flicker on a third path"
    },
    {
      "frame": 30,
      "name": "channel cools",
      "expect": "A deep red channel erodes from the sky while red arcs crawl along the cracks"
    },
    {
      "frame": 50,
      "name": "residue",
      "expect": "Deep red cracks eroding in pieces on a dark scorch, sparse arcs still crawling, debris landed, embers rising"
    },
    {
      "frame": 66,
      "name": "exit",
      "expect": "Cracks broken into dim deep-red pieces, one last small arc, embers and a trickle of ash still rising"
    }
  ],
  "acceptance": [
    "Before f10 the viewer can tell where the strike will land from the ground mark and leader",
    "The main strike, the return stroke and the after-flicker are on three visibly different paths with dark frames between them",
    "The bolt never slides or scales; it is struck whole on its frame",
    "After the flashes the burnt channel and the cracks keep red value while the effect cools to deep red and ash"
  ],
  "avoid": [
    "A white blob at the foot that lasts more than four frames",
    "A bolt that grows downward like a projectile at contact",
    "A static dark circle hanging after the cracks are out"
  ],
